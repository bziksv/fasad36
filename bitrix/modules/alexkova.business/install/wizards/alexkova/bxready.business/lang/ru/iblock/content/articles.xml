				<Ид>bxr_demo_290</Ид>
				<Наименование>Bootstrap в готовом решении зло? Да ладно!</Наименование>
				<БитриксТеги></БитриксТеги>
				<Группы>
					<Ид>164</Ид>
				</Группы>
				<Картинка>articles_files/iblock/e7e/e7e5acc1869c2c34a4646ff0de03ae9e.jpg</Картинка>
				<ЗначенияСвойств>
					<ЗначенияСвойства>
						<Ид>CML2_ACTIVE</Ид>
						<Значение>true</Значение>
					</ЗначенияСвойства>
					<ЗначенияСвойства>
						<Ид>CML2_CODE</Ид>
						<Значение>bootstrap-v-gotovom-reshenii-zlo-da-ladno</Значение>
					</ЗначенияСвойства>
					<ЗначенияСвойства>
						<Ид>CML2_SORT</Ид>
						<Значение>500</Значение>
					</ЗначенияСвойства>
					<ЗначенияСвойства>
						<Ид>CML2_ACTIVE_FROM</Ид>
						<Значение>2016-08-14 16:20:00</Значение>
					</ЗначенияСвойства>
					<ЗначенияСвойства>
